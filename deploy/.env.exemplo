# Copiar para deploy/.env e preencher. O .env NUNCA vai para o git (tem passwords).

# Endereço do site (o DNS tem de apontar para o IP estático do servidor). "localhost" para testar no PC.
DOMINIO=innovera.dstelecom.pt

# Base de dados PostgreSQL gerida do Lightsail (endpoint, utilizador e password da consola do Lightsail).
LIGACAO_BD=Host=ls-xxxxxxxx.xxxxxx.eu-west-3.rds.amazonaws.com;Port=5432;Database=innovera;Username=dbmasteruser;Password=ALTERAR;SSL Mode=Require;Trust Server Certificate=true
# Para testar no PC com --profile bd-local:
# LIGACAO_BD=Host=bd;Port=5432;Database=innovera;Username=innovera;Password=innovera-local

# Primeira conta de Administrador (criada no primeiro arranque; depois mude a password na plataforma).
ADMIN_EMAIL=inovacao@dstelecom.pt
ADMIN_PASSWORD=ALTERAR-para-uma-password-forte1

# Envio de emails pelo Amazon SES (credenciais SMTP criadas na consola do SES).
EMAIL_REMETENTE=inovacao@innovera.dstelecom.pt
EMAIL_NOME=Inovação dstelecom
SMTP_HOST=email-smtp.eu-west-3.amazonaws.com
SMTP_PORTA=587
SMTP_SSL=true
SMTP_UTILIZADOR=ALTERAR
SMTP_PASSWORD=ALTERAR
