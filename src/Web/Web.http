# Pedidos de exemplo (Visual Studio / Rider / extensão REST Client do VS Code).
@Web_HostAddress = https://localhost:7240

# Entrar com a conta de desenvolvimento (cookie de sessão)
POST {{Web_HostAddress}}/api/Conta/entrar
Content-Type: application/json

{
  "email": "admin@innovera.local",
  "password": "Innovera2026!"
}

###

# Utilizador atual, com perfis e permissões
GET {{Web_HostAddress}}/api/Utilizadores/eu

###

# Ideias em discussão
GET {{Web_HostAddress}}/api/Ideias?estado=EmDiscussao

###

# Backoffice: perfis e permissões
GET {{Web_HostAddress}}/api/Administracao/perfis

###

# Backoffice: adicionar um utilizador (recebe o convite no Mailpit, http://localhost:8025)
POST {{Web_HostAddress}}/api/Administracao/utilizadores
Content-Type: application/json

{
  "nome": "Rita Gomes",
  "email": "rita.gomes@exemplo.pt",
  "empresa": "dstelecom, s.a.",
  "perfis": ["Trabalhador"]
}
